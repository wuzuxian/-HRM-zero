syntax = "v1"

info (
	go_package: "v1/manage/user"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

type ManageUser {
	Uuid       string   `json:"uuid"`
	Username   string   `json:"username"`
	UserGender string   `json:"userGender"`
	NickName   string   `json:"nickName"`
	UserPhone  string   `json:"userPhone"`
	UserEmail  string   `json:"userEmail"`
	UserRoles  []string `json:"userRoles"`
	Status     string   `json:"status"`
	CreateTime string   `json:"createTime"`
	UpdateTime string   `json:"updateTime"`
}

type ListRequest {
	PageRequest
	Username   string `form:"username,optional"`
	UserGender string `form:"userGender,optional"`
	NickName   string `form:"nickName,optional"`
	UserPhone  string `form:"userPhone,optional"`
	UserEmail  string `form:"userEmail,optional"`
	Status     string `form:"status,optional"`
}

type ListResponse {
	PageResponse
	Records []ManageUser `json:"records"`
}

type AddRequest {
	Username   string   `json:"username"`
	UserGender string   `json:"userGender,default=1"`
	NickName   string   `json:"nickName"`
	UserPhone  string   `json:"userPhone"`
	UserEmail  string   `json:"userEmail"`
	Status     string   `json:"status,default=1"`
	Password   string   `json:"password"`
	UserRoles  []string `json:"userRoles"`
}

type AddResponse {}

type EditRequest {
	Uuid       string   `json:"uuid"`
	Username   string   `json:"username"`
	UserGender string   `json:"userGender"`
	NickName   string   `json:"nickName"`
	UserPhone  string   `json:"userPhone"`
	UserEmail  string   `json:"userEmail"`
	Status     string   `json:"status"`
	UserRoles  []string `json:"userRoles"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

// LinkedEmployee 关联员工简要信息 (工号+姓名), 供用户管理列表只读「关联员工」列回填。
// 账号↔档案的唯一写入入口在员工侧 (ADR 0007), 用户管理侧只读。
type LinkedEmployee {
	UserUuid     string `json:"userUuid"`
	EmployeeNo   string `json:"employeeNo"`
	EmployeeName string `json:"employeeName"`
}

// LinkedEmployeesRequest 批量按账号 uuid 查关联员工 (HRM-51); uuids 逗号分隔
type LinkedEmployeesRequest {
	Uuids string `form:"uuids,optional"`
}

type LinkedEmployeesResponse {
	Records []LinkedEmployee `json:"records"`
}

@server (
	prefix:          /api/v1
	group:           v1/manage/user
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /manage/getUserList (ListRequest) returns (ListResponse)

	@handler Add
	post /manage/addUser (AddRequest) returns (AddResponse)

	@handler Edit
	post /manage/editUser (EditRequest) returns (EditResponse)

	@handler Delete
	post /manage/deleteUser (DeleteRequest) returns (DeleteResponse)

	@handler LinkedEmployees
	get /manage/getLinkedEmployees (LinkedEmployeesRequest) returns (LinkedEmployeesResponse)
}

