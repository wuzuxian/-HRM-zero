syntax = "v1"

info (
	go_package: "v1/hrm/cardreplacement"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

// 补卡单（HR206，GLOSSARY「单据」）：员工提交（补卡日期、补卡类型 上班卡/下班卡、
// 补卡时间、补卡原因）；列表展示 原上班打卡/原下班打卡（提交时 hrm_punch_record 当日行快照）。
// 审批通过事务内（bill.OnApproved，类型码 206）：补卡时间写入当日 hrm_punch_record 对应列
// （上班卡→clock_in，下班卡→clock_out；无行则建行，source=card_replacement），
// 并 re-run punch.SettleDay 重算该员工该日日结。
// 生命周期（提交/审批/撤销/审批记录）走共享单据底座 v1/hrm/bill。
// 列表默认按「我的单据」过滤（创建人=当前用户），超级管理员可看全部（spec 用户故事 4）。
type HrmCardReplacement {
	Uuid             string `json:"uuid"`
	BillNo           string `json:"billNo"` // 单据编号 HR206-...
	Status           string `json:"status"` // 单据状态 unsubmitted/approving/approved/rejected/revoked
	EmployeeUuid     string `json:"employeeUuid"` // 员工档案 uuid
	EmployeeNo       string `json:"employeeNo"` // 员工工号（快照）
	EmployeeName     string `json:"employeeName"` // 员工姓名（快照）
	OrgUuid          string `json:"orgUuid"` // 员工所属部门（组织 uuid，快照）
	OrgName          string `json:"orgName"` // 部门名称（快照）
	PunchDate        string `json:"punchDate"` // 补卡日期 yyyy-MM-dd
	CardType         string `json:"cardType"` // 补卡类型 clockIn 上班卡 / clockOut 下班卡
	PunchTime        string `json:"punchTime"` // 补卡时间 YYYY-MM-DD HH:MM:SS
	Reason           string `json:"reason"` // 补卡原因
	OrigClockInTime  string `json:"origClockInTime"` // 原上班打卡（快照，空=缺卡）
	OrigClockOutTime string `json:"origClockOutTime"` // 原下班打卡（快照，空=缺卡）
	CreatorUuid      string `json:"creatorUuid"` // 申请人 uuid
	CreatorName      string `json:"creatorName"` // 申请人姓名
	CreateTime       string `json:"createTime"`
	UpdateTime       string `json:"updateTime"`
}

type ListRequest {
	PageRequest
	BillNo     string `form:"billNo,optional"` // 单据编号（模糊）
	Status     string `form:"status,optional"` // 单据状态
	EmployeeNo string `form:"employeeNo,optional"` // 员工工号
	CardType   string `form:"cardType,optional"` // 补卡类型 clockIn/clockOut
	Mine       int64  `form:"mine,optional"` // 1=强制只看我的单据
}

type ListResponse {
	PageResponse
	Records []HrmCardReplacement `json:"records"`
}

type AddRequest {
	EmployeeUuid string `json:"employeeUuid,optional"`
	EmployeeNo   string `json:"employeeNo"`
	EmployeeName string `json:"employeeName"`
	OrgUuid      string `json:"orgUuid,optional"`
	OrgName      string `json:"orgName,optional"`
	PunchDate    string `json:"punchDate"` // yyyy-MM-dd
	CardType     string `json:"cardType"` // clockIn/clockOut
	PunchTime    string `json:"punchTime"` // YYYY-MM-DD HH:MM:SS
	Reason       string `json:"reason,optional"`
}

type AddResponse {}

type EditRequest {
	Uuid         string `json:"uuid"`
	EmployeeUuid string `json:"employeeUuid,optional"`
	EmployeeNo   string `json:"employeeNo"`
	EmployeeName string `json:"employeeName"`
	OrgUuid      string `json:"orgUuid,optional"`
	OrgName      string `json:"orgName,optional"`
	PunchDate    string `json:"punchDate"`
	CardType     string `json:"cardType"`
	PunchTime    string `json:"punchTime"`
	Reason       string `json:"reason,optional"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

@server (
	prefix:          /api/v1
	group:           v1/hrm/cardreplacement
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /hrm/getCardReplacementList (ListRequest) returns (ListResponse)

	@handler Add
	post /hrm/addCardReplacement (AddRequest) returns (AddResponse)

	@handler Edit
	post /hrm/editCardReplacement (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deleteCardReplacement (DeleteRequest) returns (DeleteResponse)
}

