syntax = "v1"

info (
	go_package: "v1/hrm/punch"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

// 打卡类型: 上班卡 clockIn / 下班卡 clockOut.
type PunchRequest {
	// Type 打卡类型: clockIn=上班卡 clockOut=下班卡
	Type string `json:"type"`
	// Location 打卡地点（GPS 地址文本，选填；外勤打卡时为地点描述）
	Location string `json:"location,optional"`
	// EmployeeUuid 员工档案 uuid（管理端代打卡时指定；员工端缺省取当前登录人）
	EmployeeUuid string `json:"employeeUuid,optional"`
}

type PunchResponse {
	// PunchDate 打卡日期（跨天班下班卡归属上班日）
	PunchDate string `json:"punchDate"`
	// ClockInTime 签到时间（yyyy-MM-dd HH:mm:ss，空=缺上班卡）
	ClockInTime string `json:"clockInTime"`
	// ClockOutTime 签退时间
	ClockOutTime string `json:"clockOutTime"`
	// SettleStatus 日结状态（本次打卡后的即时判定）
	SettleStatus string `json:"settleStatus"`
}

// 打卡记录（管理端列表行 / 员工端我的打卡列表行共用）
type HrmPunchRecord {
	Uuid               string  `json:"uuid"`
	PunchDate          string  `json:"punchDate"`
	EmployeeUuid       string  `json:"employeeUuid"`
	UserUuid           string  `json:"userUuid"`
	Username           string  `json:"username"`
	EmployeeNo         string  `json:"employeeNo"`
	EmployeeName       string  `json:"employeeName"`
	OrgName            string  `json:"orgName"`
	Weekday            string  `json:"weekday"`
	ClockInTime        string  `json:"clockInTime"`
	ClockInStatus      string  `json:"clockInStatus"`
	ClockInLocation    string  `json:"clockInLocation"`
	ClockOutTime       string  `json:"clockOutTime"`
	ClockOutStatus     string  `json:"clockOutStatus"`
	ClockOutLocation   string  `json:"clockOutLocation"`
	Overtime           string  `json:"overtime"`
	Source             string  `json:"source"`
	RuleSource         string  `json:"ruleSource"`
	SettleStatus       string  `json:"settleStatus"`
	SettleLateMinutes  int64   `json:"settleLateMinutes"`
	SettleEarlyMinutes int64   `json:"settleEarlyMinutes"`
	SettleWorkHours    float64 `json:"settleWorkHours"`
	SettleTime         string  `json:"settleTime"`
	CreateTime         string  `json:"createTime"`
	UpdateTime         string  `json:"updateTime"`
}

// MyListRequest 员工端「考勤打卡」页：我的打卡记录列表（4.1，按当前登录人过滤）。
type MyListRequest {
	PageRequest
	StartDate        string `form:"startDate,optional"`
	EndDate          string `form:"endDate,optional"`
	ClockInOutStatus string `form:"clockStatus,optional"`
}

type MyListResponse {
	PageResponse
	Records []HrmPunchRecord `json:"records"`
}

// ListRequest 管理端「打卡记录」页（4.4）：筛选日期区间/姓名/签到状态。
type ListRequest {
	PageRequest
	StartDate     string `form:"startDate,optional"`
	EndDate       string `form:"endDate,optional"`
	Name          string `form:"name,optional"`
	ClockInStatus string `form:"clockInStatus,optional"`
}

type ListResponse {
	PageResponse
	Records []HrmPunchRecord `json:"records"`
}

// AddRequest 管理端手动新增打卡记录（补录外部数据单行）。
type AddRequest {
	EmployeeUuid     string `json:"employeeUuid"`
	PunchDate        string `json:"punchDate"`
	ClockInTime      string `json:"clockInTime,optional"`
	ClockInStatus    string `json:"clockInStatus,optional"`
	ClockInLocation  string `json:"clockInLocation,optional"`
	ClockOutTime     string `json:"clockOutTime,optional"`
	ClockOutStatus   string `json:"clockOutStatus,optional"`
	ClockOutLocation string `json:"clockOutLocation,optional"`
	Overtime         string `json:"overtime,optional"`
}

type AddResponse {}

// EditRequest 管理端修改打卡记录（行操作「修改」）。
type EditRequest {
	Uuid             string `json:"uuid"`
	ClockInTime      string `json:"clockInTime,optional"`
	ClockInStatus    string `json:"clockInStatus,optional"`
	ClockInLocation  string `json:"clockInLocation,optional"`
	ClockOutTime     string `json:"clockOutTime,optional"`
	ClockOutStatus   string `json:"clockOutStatus,optional"`
	ClockOutLocation string `json:"clockOutLocation,optional"`
	Overtime         string `json:"overtime,optional"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

// ExportRequest 管理端导出打卡记录（同列表筛选条件，返回 base64 xlsx）。
type ExportRequest {
	StartDate     string `json:"startDate,optional"`
	EndDate       string `json:"endDate,optional"`
	Name          string `json:"name,optional"`
	ClockInStatus string `json:"clockInStatus,optional"`
}

type ExportResponse {
	FileName string `json:"fileName"`
	Content  string `json:"content"`
}

// ImportRequest 管理端导入外部考勤数据（HRM-22 考勤统计复用同一 CSV 约定；单行非法即整批拒绝并报行号）。
type ImportRequest {
	FileName    string `json:"fileName"`
	FileContent string `json:"fileContent"`
}

type ImportResponse {
	SuccessCount int64 `json:"successCount"`
}

// StatisticsRequest 考勤统计（HRM-22 考勤统计页）：统计卡 + 按人明细，
// 从 hrm_punch_record settle_* 快照列按日期区间聚合。
// 应出勤天 = 区间内工作日数（按员工生效规则 WorkDays 口径，1=周一..7=周日）；
// 异常 = settle_status ∈ {late, early, missing}（rest/no_rule 不算异常）。
type StatisticsRequest {
	PageRequest
	StartDate    string `form:"startDate,optional"`
	EndDate      string `form:"endDate,optional"`
	Name         string `form:"name,optional"`
	OnlyAbnormal string `form:"onlyAbnormal,optional"`
}

// HrmPunchStatsCard 统计卡聚合（区间内全体员工）。
type HrmPunchStatsCard {
	// StatEmployees 统计人数（区间内有记录/日结行的员工数）
	StatEmployees int64 `json:"statEmployees"`
	// AbnormalEmployees 异常人数（任一日 settle_status 异常的员工数）
	AbnormalEmployees int64 `json:"abnormalEmployees"`
	// LateCount 迟到次数（settle_status=late 的天数）
	LateCount int64 `json:"lateCount"`
	// EarlyCount 早退次数
	EarlyCount int64 `json:"earlyCount"`
	// MissingCount 缺卡次数
	MissingCount int64 `json:"missingCount"`
	// RecordCount 记录条数（区间内 hrm_punch_record 行数）
	RecordCount int64 `json:"recordCount"`
}

// HrmPunchPersonStats 按人明细行。
type HrmPunchPersonStats {
	EmployeeUuid string `json:"employeeUuid"`
	EmployeeNo   string `json:"employeeNo"`
	EmployeeName string `json:"employeeName"`
	OrgName      string `json:"orgName"`
	// ExpectedDays 应出勤天 = 区间内工作日数（按生效规则 WorkDays）
	ExpectedDays int64 `json:"expectedDays"`
	// AttendDays 出勤天 = 非 missing/非缺勤的判定日数（normal/late/early/field 视为出勤）
	AttendDays int64 `json:"attendDays"`
	// AbsentDays 缺勤天 = settle_status=missing 且无打卡的天数
	AbsentDays   int64 `json:"absentDays"`
	LateCount    int64 `json:"lateCount"`
	EarlyCount   int64 `json:"earlyCount"`
	MissingCount int64 `json:"missingCount"`
	// AbnormalTotal 异常合计 = late+early+missing
	AbnormalTotal int64 `json:"abnormalTotal"`
	// AbnormalSummary 异常摘要（如「迟到3次,缺卡1次」；无异常为空）
	AbnormalSummary string `json:"abnormalSummary"`
	// TotalWorkHours 区间总工时（小时）
	TotalWorkHours float64 `json:"totalWorkHours"`
}

type StatisticsResponse {
	PageResponse
	// Cards 统计卡（对区间内全体员工聚合，与分页无关）
	Cards   HrmPunchStatsCard     `json:"cards"`
	Records []HrmPunchPersonStats `json:"records"`
}

// StatisticsDetailRequest 行操作「查看明细」：某员工在日期区间内的逐日 settle 详情（复用打卡记录数据）。
type StatisticsDetailRequest {
	EmployeeUuid string `form:"employeeUuid"`
	StartDate    string `form:"startDate,optional"`
	EndDate      string `form:"endDate,optional"`
}

type StatisticsDetailResponse {
	Records []HrmPunchRecord `json:"records"`
}

// SettleRequest 手动日结（4.4 工具栏）：指定员工+日期逐日结算；日期区间批量时 employeeUuids 可省略为全体员工。
type SettleRequest {
	EmployeeUuids []string `json:"employeeUuids,optional"`
	StartDate     string   `json:"startDate"`
	EndDate       string   `json:"endDate,optional"`
}

type HrmSettleResult {
	EmployeeUuid string  `json:"employeeUuid"`
	EmployeeName string  `json:"employeeName"`
	PunchDate    string  `json:"punchDate"`
	SettleStatus string  `json:"settleStatus"`
	LateMinutes  int64   `json:"lateMinutes"`
	EarlyMinutes int64   `json:"earlyMinutes"`
	WorkHours    float64 `json:"workHours"`
}

type SettleResponse {
	Records []HrmSettleResult `json:"records"`
}

@server (
	prefix:          /api/v1
	group:           v1/hrm/punch
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler Punch
	post /hrm/punch (PunchRequest) returns (PunchResponse)

	@handler MyList
	get /hrm/getMyPunchList (MyListRequest) returns (MyListResponse)

	@handler List
	get /hrm/getPunchList (ListRequest) returns (ListResponse)

	@handler Add
	post /hrm/addPunchRecord (AddRequest) returns (AddResponse)

	@handler Edit
	post /hrm/editPunchRecord (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deletePunchRecord (DeleteRequest) returns (DeleteResponse)

	@handler Export
	post /hrm/exportPunchRecord (ExportRequest) returns (ExportResponse)

	@handler Import
	post /hrm/importPunchRecord (ImportRequest) returns (ImportResponse)

	@handler Settle
	post /hrm/settlePunchDay (SettleRequest) returns (SettleResponse)

	@handler Statistics
	get /hrm/getPunchStatistics (StatisticsRequest) returns (StatisticsResponse)

	@handler StatisticsDetail
	get /hrm/getPunchStatisticsDetail (StatisticsDetailRequest) returns (StatisticsDetailResponse)
}

