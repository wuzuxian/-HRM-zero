syntax = "v1"

info (
	go_package: "v1/hrm/regularization"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

// 员工转正单（HR202，GLOSSARY「单据」）：选择员工带出档案快照
// （工号/姓名/部门/公司/职位/职务/入职日期/预计转正日期），实际转正日期，备注。
// 生命周期（提交/审批/撤销/审批记录）走共享单据底座 v1/hrm/bill，类型码 202。
// 审批通过回写（spec 用户故事 20）：OnApproved 事务内更新 hrm_employee
// person_status='1'(正式) + formal_date(转正日期，优先单据实际转正日期)。
// 列表默认按「我的单据」过滤（创建人=当前用户），超级管理员可看全部（spec 用户故事 4）。
type HrmRegularization {
	Uuid               string `json:"uuid"`
	BillNo             string `json:"billNo"` // 单据编号 HR202-...
	Status             string `json:"status"` // 单据状态 unsubmitted/approving/approved/rejected/revoked
	EmployeeUuid       string `json:"employeeUuid"` // 员工档案 uuid
	EmployeeNo         string `json:"employeeNo"` // 员工工号（快照）
	EmployeeName       string `json:"employeeName"` // 员工姓名（快照）
	OrgUuid            string `json:"orgUuid"` // 员工所属部门（组织 uuid，快照）
	CompanyUuid        string `json:"companyUuid"` // 员工所属公司（组织 uuid，快照）
	Position           string `json:"position"` // 职位（快照）
	Post               string `json:"post"` // 职务（快照）
	PersonStatus       string `json:"personStatus"` // 人员状态（快照，制单时档案值）
	HireDate           string `json:"hireDate"` // 入职日期 YYYY-MM-DD（快照）
	ExpectedFormalDate string `json:"expectedFormalDate"` // 预计转正日期 YYYY-MM-DD（快照）
	FormalDate         string `json:"formalDate"` // 实际转正日期 YYYY-MM-DD
	Remark             string `json:"remark"` // 备注
	Applied            int64  `json:"applied"` // 审批回写是否已完成 1=是 0=否
	CreatorUuid        string `json:"creatorUuid"` // 申请人 uuid
	CreatorName        string `json:"creatorName"` // 申请人姓名
	CreateTime         string `json:"createTime"`
	UpdateTime         string `json:"updateTime"`
}

type ListRequest {
	PageRequest
	BillNo     string `form:"billNo,optional"` // 单据编号（模糊）
	Status     string `form:"status,optional"` // 单据状态
	EmployeeNo string `form:"employeeNo,optional"` // 员工工号（模糊）
	Mine       int64  `form:"mine,optional"` // 1=强制只看我的单据（默认行为即我的单据，管理员可传 0 看全部由后端角色判定兜底）
}

type ListResponse {
	PageResponse
	Records []HrmRegularization `json:"records"`
}

type AddRequest {
	EmployeeUuid       string `json:"employeeUuid,optional"`
	EmployeeNo         string `json:"employeeNo"`
	EmployeeName       string `json:"employeeName"`
	OrgUuid            string `json:"orgUuid,optional"`
	CompanyUuid        string `json:"companyUuid,optional"`
	Position           string `json:"position,optional"`
	Post               string `json:"post,optional"`
	PersonStatus       string `json:"personStatus,optional"`
	HireDate           string `json:"hireDate,optional"`
	ExpectedFormalDate string `json:"expectedFormalDate,optional"`
	FormalDate         string `json:"formalDate,optional"` // 实际转正日期 YYYY-MM-DD
	Remark             string `json:"remark,optional"`
}

type AddResponse {}

type EditRequest {
	Uuid               string `json:"uuid"`
	EmployeeUuid       string `json:"employeeUuid,optional"`
	EmployeeNo         string `json:"employeeNo"`
	EmployeeName       string `json:"employeeName"`
	OrgUuid            string `json:"orgUuid,optional"`
	CompanyUuid        string `json:"companyUuid,optional"`
	Position           string `json:"position,optional"`
	Post               string `json:"post,optional"`
	PersonStatus       string `json:"personStatus,optional"`
	HireDate           string `json:"hireDate,optional"`
	ExpectedFormalDate string `json:"expectedFormalDate,optional"`
	FormalDate         string `json:"formalDate,optional"`
	Remark             string `json:"remark,optional"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

@server (
	prefix:          /api/v1
	group:           v1/hrm/regularization
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /hrm/getRegularizationList (ListRequest) returns (ListResponse)

	@handler Add
	post /hrm/addRegularization (AddRequest) returns (AddResponse)

	@handler Edit
	post /hrm/editRegularization (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deleteRegularization (DeleteRequest) returns (DeleteResponse)
}

