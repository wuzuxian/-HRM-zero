syntax = "v1"

info (
	go_package: "v1/hrm/bill"
)

import (
	"../../common/response.api"
)

// 共享单据审批底座（ADR-0001）：提交/审批(通过/驳回)/撤销 + 审批记录。
// 各类单据（HR201~HR217）在自身 logic 包中注册 bill.Handler 后即可使用这些
// 共享端点；按钮码约定 v1:hrm:bill:submit / approve / reject / revoke（裸码
// hrm:bill:*），由各单据页面菜单的 permissions JSON 预置。
type BillActionRequest {
	BillType string `json:"billType"` // 单据类型码（如 201）
	BillUuid string `json:"billUuid"` // 单据 uuid
	Opinion  string `json:"opinion,optional"` // 审批意见
}

type BillActionResponse {}

type ApprovalRecord {
	BillNo       string `json:"billNo"` // 单据编号
	Action       string `json:"action"` // 动作 submit/approve/reject/revoke
	FromStatus   string `json:"fromStatus"` // 动作前单据状态
	ToStatus     string `json:"toStatus"` // 动作后单据状态
	OperatorName string `json:"operatorName"` // 操作人姓名
	Opinion      string `json:"opinion"` // 审批意见
	CreateTime   string `json:"createTime"` // 操作时间
}

type GetApprovalRecordListRequest {
	BillType string `form:"billType"` // 单据类型码（如 201）
	BillUuid string `form:"billUuid"` // 单据 uuid
}

type GetApprovalRecordListResponse {
	PageResponse
	Records []*ApprovalRecord `json:"records"`
}

// 共享单据导出（spec 用户故事 23: 每类人事单据支持导出）。billType = 3 位类型码
// （201 入职 / 203 调动 / 202 转正 / 204 离职 …），导出口径与各单据列表逻辑一致
// （默认「我的单据」，管理员级角色可看全部）。按钮码 v1:hrm:bill:export 种子在
// 人事管理目录菜单 permissions。
type ExportBillListRequest {
	BillType string `form:"billType"` // 单据类型码（如 201）
	Mine     int64  `form:"mine,optional"` // 1=强制只看我的单据
}

type ExportBillListResponse {
	FileName string `json:"fileName"` // xlsx 文件名
	Content  string `json:"content"` // xlsx 内容（base64）
}

@server (
	prefix:          /api/v1
	group:           v1/hrm/bill
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler Submit
	post /hrm/submitBill (BillActionRequest) returns (BillActionResponse)

	@handler Approve
	post /hrm/approveBill (BillActionRequest) returns (BillActionResponse)

	@handler Reject
	post /hrm/rejectBill (BillActionRequest) returns (BillActionResponse)

	@handler Revoke
	post /hrm/revokeBill (BillActionRequest) returns (BillActionResponse)

	@handler GetApprovalRecordList
	get /hrm/getApprovalRecordList (GetApprovalRecordListRequest) returns (GetApprovalRecordListResponse)

	@handler ExportBillList
	get /hrm/exportBillList (ExportBillListRequest) returns (ExportBillListResponse)
}

