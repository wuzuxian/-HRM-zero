syntax = "v1"

info (
	go_package: "v1/hrm/perf_template"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

// 考核模板（HRM-40，演示站 9.1 模板管理）：模板内配置指标与权重，权重之和校验=100%。
type TemplateItemRequest {
	IndicatorUuid string  `json:"indicatorUuid"`
	Weight        float64 `json:"weight"` // 权重（百分比）
}

type HrmPerfTemplateItem {
	Uuid          string  `json:"uuid"`
	IndicatorUuid string  `json:"indicatorUuid"`
	Weight        float64 `json:"weight"` // 权重（百分比）
	IndicatorCode string  `json:"indicatorCode"` // 指标编码（快照自指标库）
	IndicatorName string  `json:"indicatorName"`
	IndicatorType string  `json:"indicatorType"`
	Unit          string  `json:"unit"`
	ScoreRule     string  `json:"scoreRule"`
	DataSource    string  `json:"dataSource"`
}

type HrmPerfTemplate {
	Uuid       string                `json:"uuid"`
	Name       string                `json:"name"`
	Status     string                `json:"status"` // 1=启用 0=停用
	Remark     string                `json:"remark"`
	Items      []HrmPerfTemplateItem `json:"items"`
	CreateTime string                `json:"createTime"`
	UpdateTime string                `json:"updateTime"`
}

type ListRequest {
	PageRequest
	Name   string `form:"name,optional"`
	Status string `form:"status,optional"`
}

type ListResponse {
	PageResponse
	Records []HrmPerfTemplate `json:"records"`
}

type GetDetailRequest {
	Uuid string `form:"uuid"`
}

type GetDetailResponse {
	HrmPerfTemplate
}

type AddRequest {
	Name   string                `json:"name"`
	Status string                `json:"status,default=1"`
	Remark string                `json:"remark,optional"`
	Items  []TemplateItemRequest `json:"items"`
}

type AddResponse {}

type EditRequest {
	Uuid   string                `json:"uuid"`
	Name   string                `json:"name"`
	Status string                `json:"status"`
	Remark string                `json:"remark,optional"`
	Items  []TemplateItemRequest `json:"items"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

@server (
	prefix:          /api/v1
	group:           v1/hrm/perf_template
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /hrm/getPerfTemplateList (ListRequest) returns (ListResponse)

	@handler GetDetail
	get /hrm/getPerfTemplateDetail (GetDetailRequest) returns (GetDetailResponse)

	@handler Add
	post /hrm/addPerfTemplate (AddRequest) returns (AddResponse)

	@handler Edit
	post /hrm/editPerfTemplate (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deletePerfTemplate (DeleteRequest) returns (DeleteResponse)
}

