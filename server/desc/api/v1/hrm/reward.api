syntax = "v1"

info (
	go_package: "v1/hrm/reward"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

// 奖惩单（HR215，GLOSSARY「单据」）：奖惩类型 奖励/处分，级别 公司级/部门级/通报/其他，
// 文号、发生日期、金额，奖惩原因。
// 生命周期（提交/审批/撤销/审批记录）走共享单据底座 v1/hrm/bill，类型码 215。
// 审批通过后同步为薪资项目的奖惩奖励/奖惩扣款数据源（spec 用户故事 53）：
// synced 标记 + salary_month 入账年月，HRM-34 薪资项目/HRM-37 试算按 员工+年月 取数。
// 列表默认按「我的单据」过滤（创建人=当前用户），超级管理员可看全部（spec 用户故事 4）。
type HrmReward {
	Uuid         string  `json:"uuid"`
	BillNo       string  `json:"billNo"` // 单据编号 HR215-...
	Status       string  `json:"status"` // 单据状态 unsubmitted/approving/approved/rejected/revoked
	EmployeeUuid string  `json:"employeeUuid"` // 员工档案 uuid
	EmployeeNo   string  `json:"employeeNo"` // 员工工号
	EmployeeName string  `json:"employeeName"` // 员工姓名
	RewardType   string  `json:"rewardType"` // 奖惩类型 reward=奖励 punishment=处分
	RewardLevel  string  `json:"rewardLevel"` // 奖惩级别 company=公司级 dept=部门级 notice=通报 other=其他
	DocNo        string  `json:"docNo"` // 文号
	OccurDate    string  `json:"occurDate"` // 发生日期 YYYY-MM-DD
	Amount       float64 `json:"amount"` // 金额（奖励为发放金额，处分/扣款为正数金额，0=不涉及）
	Reason       string  `json:"reason"` // 奖惩原因/事由
	SalaryMonth  string  `json:"salaryMonth"` // 入账薪资年月 YYYY-MM
	Synced       int64   `json:"synced"` // 薪资数据源同步标记 1=已同步
	CreatorUuid  string  `json:"creatorUuid"` // 申请人 uuid
	CreatorName  string  `json:"creatorName"` // 申请人姓名
	CreateTime   string  `json:"createTime"`
	UpdateTime   string  `json:"updateTime"`
}

type ListRequest {
	PageRequest
	BillNo     string `form:"billNo,optional"` // 单据编号（模糊）
	Status     string `form:"status,optional"` // 单据状态
	RewardType string `form:"rewardType,optional"` // 奖惩类型 reward/punishment
	EmployeeNo string `form:"employeeNo,optional"` // 员工工号（模糊）
	Mine       int64  `form:"mine,optional"` // 1=强制只看我的单据（默认行为即我的单据，管理员可传 0 看全部由后端角色判定兜底）
}

type ListResponse {
	PageResponse
	Records []HrmReward `json:"records"`
}

type AddRequest {
	EmployeeUuid string  `json:"employeeUuid,optional"`
	EmployeeNo   string  `json:"employeeNo"`
	EmployeeName string  `json:"employeeName"`
	RewardType   string  `json:"rewardType"`
	RewardLevel  string  `json:"rewardLevel"`
	DocNo        string  `json:"docNo,optional"`
	OccurDate    string  `json:"occurDate"` // YYYY-MM-DD
	Amount       float64 `json:"amount,optional"`
	Reason       string  `json:"reason,optional"`
	SalaryMonth  string  `json:"salaryMonth,optional"` // YYYY-MM，空=发生日期所在月
}

type AddResponse {}

type EditRequest {
	Uuid         string  `json:"uuid"`
	EmployeeUuid string  `json:"employeeUuid,optional"`
	EmployeeNo   string  `json:"employeeNo"`
	EmployeeName string  `json:"employeeName"`
	RewardType   string  `json:"rewardType"`
	RewardLevel  string  `json:"rewardLevel"`
	DocNo        string  `json:"docNo,optional"`
	OccurDate    string  `json:"occurDate"`
	Amount       float64 `json:"amount,optional"`
	Reason       string  `json:"reason,optional"`
	SalaryMonth  string  `json:"salaryMonth,optional"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

@server (
	prefix:          /api/v1
	group:           v1/hrm/reward
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /hrm/getRewardList (ListRequest) returns (ListResponse)

	@handler Add
	post /hrm/addReward (AddRequest) returns (AddResponse)

	@handler Edit
	post /hrm/editReward (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deleteReward (DeleteRequest) returns (DeleteResponse)
}

