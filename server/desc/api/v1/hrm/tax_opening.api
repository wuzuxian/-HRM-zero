syntax = "v1"

info (
	go_package: "v1/hrm/tax_opening"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

// HrmTaxOpening 个税累计期初: 累计预扣法（HRM-37 薪资试算消费）的期初累计数，
// 员工 + 主体 + 年度 唯一。各累计列均为截至 until_month 的累计值。
type HrmTaxOpening {
	Uuid                  string  `json:"uuid"`
	EmployeeUuid          string  `json:"employeeUuid"`
	EmployeeName          string  `json:"employeeName"`
	IdCard                string  `json:"idCard"`
	SubjectUuid           string  `json:"subjectUuid"`
	SubjectName           string  `json:"subjectName"`
	TaxYear               string  `json:"taxYear"`
	UntilMonth            int64   `json:"untilMonth"`
	IncomeTotal           float64 `json:"incomeTotal"`
	SpecialDeductionTotal float64 `json:"specialDeductionTotal"`
	SpecialExtraTotal     float64 `json:"specialExtraTotal"`
	ExemptTotal           float64 `json:"exemptTotal"`
	OtherDeductionTotal   float64 `json:"otherDeductionTotal"`
	TaxableIncomeTotal    float64 `json:"taxableIncomeTotal"`
	TaxPaidTotal          float64 `json:"taxPaidTotal"`
	Remark                string  `json:"remark"`
	CreateTime            string  `json:"createTime"`
	UpdateTime            string  `json:"updateTime"`
}

type ListRequest {
	PageRequest
	EmployeeName string `form:"employeeName,optional"`
	SubjectUuid  string `form:"subjectUuid,optional"`
	TaxYear      string `form:"taxYear,optional"`
}

type ListResponse {
	PageResponse
	Records []HrmTaxOpening `json:"records"`
}

type AddRequest {
	EmployeeUuid          string  `json:"employeeUuid"`
	SubjectUuid           string  `json:"subjectUuid,optional"`
	TaxYear               string  `json:"taxYear"`
	UntilMonth            int64   `json:"untilMonth"`
	IncomeTotal           float64 `json:"incomeTotal,optional"`
	SpecialDeductionTotal float64 `json:"specialDeductionTotal,optional"`
	SpecialExtraTotal     float64 `json:"specialExtraTotal,optional"`
	ExemptTotal           float64 `json:"exemptTotal,optional"`
	OtherDeductionTotal   float64 `json:"otherDeductionTotal,optional"`
	TaxableIncomeTotal    float64 `json:"taxableIncomeTotal,optional"`
	TaxPaidTotal          float64 `json:"taxPaidTotal,optional"`
	Remark                string  `json:"remark,optional"`
}

type AddResponse {}

type EditRequest {
	Uuid                  string  `json:"uuid"`
	EmployeeUuid          string  `json:"employeeUuid"`
	SubjectUuid           string  `json:"subjectUuid,optional"`
	TaxYear               string  `json:"taxYear"`
	UntilMonth            int64   `json:"untilMonth"`
	IncomeTotal           float64 `json:"incomeTotal,optional"`
	SpecialDeductionTotal float64 `json:"specialDeductionTotal,optional"`
	SpecialExtraTotal     float64 `json:"specialExtraTotal,optional"`
	ExemptTotal           float64 `json:"exemptTotal,optional"`
	OtherDeductionTotal   float64 `json:"otherDeductionTotal,optional"`
	TaxableIncomeTotal    float64 `json:"taxableIncomeTotal,optional"`
	TaxPaidTotal          float64 `json:"taxPaidTotal,optional"`
	Remark                string  `json:"remark,optional"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

type ImportRequest {
	FileName string `json:"fileName"`
	Content  string `json:"content"`
}

type ImportResponse {
	SuccessCount int64 `json:"successCount"`
}

type ExportResponse {
	FileName string `json:"fileName"`
	Content  string `json:"content"`
}

@server (
	prefix:          /api/v1
	group:           v1/hrm/tax_opening
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /hrm/getTaxOpeningList (ListRequest) returns (ListResponse)

	@handler Add
	post /hrm/addTaxOpening (AddRequest) returns (AddResponse)

	@handler Edit
	post /hrm/editTaxOpening (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deleteTaxOpening (DeleteRequest) returns (DeleteResponse)

	@handler Import
	post /hrm/importTaxOpening (ImportRequest) returns (ImportResponse)

	@handler Export
	get /hrm/exportTaxOpening returns (ExportResponse)
}

