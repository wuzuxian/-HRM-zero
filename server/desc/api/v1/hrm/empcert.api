syntax = "v1"

info (
	go_package: "v1/hrm/empcert"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

// 员工证照（HRM-05，spec 用户故事 16/17）：员工资质证照维护（证书类型/证号/到期日），
// join hrm_employee.uuid。证号明文存储（编辑回显需要），列表/预警出参统一脱敏
// （MaskCertNo：保留前 2 后 2，中间打码）。
// 与培训证书 hrm_training_certificate（HRM-30/31，学员维度）无关。
type HrmEmployeeCertificate {
	Uuid         string `json:"uuid"`
	EmployeeUuid string `json:"employeeUuid"` // 员工档案 uuid
	EmployeeNo   string `json:"employeeNo"` // 员工工号（快照）
	EmployeeName string `json:"employeeName"` // 员工姓名（快照）
	OrgUuid      string `json:"orgUuid"` // 员工所属部门（组织 uuid，快照）
	CertType     string `json:"certType"` // 证书类型（身份证/学历证书/职业资格证等）
	CertNo       string `json:"certNo"` // 证号（出参脱敏，如 4408**************12）
	IssueDate    string `json:"issueDate"` // 发证日期 YYYY-MM-DD
	ExpiryDate   string `json:"expiryDate"` // 到期日 YYYY-MM-DD
	DaysToExpiry int64  `json:"daysToExpiry"` // 距到期天数（负数=已过期 N 天）
	ExpiryState  string `json:"expiryState"` // 预警状态 normal/warning(≤90天)/expired
	Remark       string `json:"remark"` // 备注
	CreateTime   string `json:"createTime"`
	UpdateTime   string `json:"updateTime"`
}

type ListRequest {
	PageRequest
	EmployeeName string `form:"employeeName,optional"` // 员工姓名（模糊）
	EmployeeNo   string `form:"employeeNo,optional"` // 员工工号（模糊）
	CertType     string `form:"certType,optional"` // 证书类型（模糊）
	ExpiryState  string `form:"expiryState,optional"` // 预警状态筛选 normal/warning/expired
}

type ListResponse {
	PageResponse
	Records []HrmEmployeeCertificate `json:"records"`
}

type AddRequest {
	EmployeeUuid string `json:"employeeUuid"` // 员工档案 uuid（必填，带出快照）
	CertType     string `json:"certType"` // 证书类型
	CertNo       string `json:"certNo"` // 证号（明文提交）
	IssueDate    string `json:"issueDate,optional"`
	ExpiryDate   string `json:"expiryDate,optional"`
	Remark       string `json:"remark,optional"`
}

type AddResponse {}

type EditRequest {
	Uuid       string `json:"uuid"`
	CertType   string `json:"certType"`
	CertNo     string `json:"certNo"` // 明文提交（若与脱敏值相同则视为未修改）
	IssueDate  string `json:"issueDate,optional"`
	ExpiryDate string `json:"expiryDate,optional"`
	Remark     string `json:"remark,optional"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

@server (
	prefix:          /api/v1
	group:           v1/hrm/empcert
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /hrm/getEmployeeCertificateList (ListRequest) returns (ListResponse)

	@handler Add
	post /hrm/addEmployeeCertificate (AddRequest) returns (AddResponse)

	@handler Edit
	post /hrm/editEmployeeCertificate (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deleteEmployeeCertificate (DeleteRequest) returns (DeleteResponse)
}

