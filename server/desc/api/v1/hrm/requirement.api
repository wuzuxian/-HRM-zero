syntax = "v1"

info (
	go_package: "v1/hrm/requirement"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

// 招聘需求单（HR207，GLOSSARY「单据」）：岗位名称/岗位类别（技术类…）、需求人数、
// 紧急度（普通/紧急）、期望到岗日期、所属部门、需求说明。
// 生命周期（提交/审批/撤销/审批记录）走共享单据底座 v1/hrm/bill，类型码 207。
// 发布衔接接缝（spec 用户故事 43→44）：审批通过（approved）的需求可被招聘职位（HRM-25）
// 通过 requirement_uuid 引用；非 approved 状态的需求不可发布职位。
// 列表默认按「我的单据」过滤（创建人=当前用户），超级管理员可看全部（spec 用户故事 4）。
type HrmRequirement {
	Uuid            string `json:"uuid"`
	BillNo          string `json:"billNo"` // 单据编号 HR207-...
	Status          string `json:"status"` // 单据状态 unsubmitted/approving/approved/rejected/revoked
	PostName        string `json:"postName"` // 岗位名称
	PostCategory    string `json:"postCategory"` // 岗位类别 tech/product/design/operation/market/function/other
	Headcount       int64  `json:"headcount"` // 需求人数
	Urgency         string `json:"urgency"` // 紧急度 normal=普通 urgent=紧急
	ExpectDate      string `json:"expectDate"` // 期望到岗日期 YYYY-MM-DD
	OrgUuid         string `json:"orgUuid"` // 所属部门（组织 uuid）
	OrgName         string `json:"orgName"` // 所属部门名称（快照）
	RequirementDesc string `json:"requirementDesc"` // 需求说明/任职要求
	CreatorUuid     string `json:"creatorUuid"` // 申请人 uuid
	CreatorName     string `json:"creatorName"` // 申请人姓名
	CreateTime      string `json:"createTime"`
	UpdateTime      string `json:"updateTime"`
}

type ListRequest {
	PageRequest
	BillNo       string `form:"billNo,optional"` // 单据编号（模糊）
	Status       string `form:"status,optional"` // 单据状态
	PostName     string `form:"postName,optional"` // 岗位名称（模糊）
	PostCategory string `form:"postCategory,optional"` // 岗位类别
	Urgency      string `form:"urgency,optional"` // 紧急度
	OrgUuid      string `form:"orgUuid,optional"` // 所属部门（组织 uuid）
	Mine         int64  `form:"mine,optional"` // 1=强制只看我的单据（默认行为即我的单据，管理员可传 0 看全部由后端角色判定兜底）
}

type ListResponse {
	PageResponse
	Records []HrmRequirement `json:"records"`
}

type AddRequest {
	PostName        string `json:"postName"`
	PostCategory    string `json:"postCategory"`
	Headcount       int64  `json:"headcount"`
	Urgency         string `json:"urgency"`
	ExpectDate      string `json:"expectDate"`
	OrgUuid         string `json:"orgUuid,optional"`
	OrgName         string `json:"orgName,optional"`
	RequirementDesc string `json:"requirementDesc,optional"`
}

type AddResponse {}

type EditRequest {
	Uuid            string `json:"uuid"`
	PostName        string `json:"postName"`
	PostCategory    string `json:"postCategory"`
	Headcount       int64  `json:"headcount"`
	Urgency         string `json:"urgency"`
	ExpectDate      string `json:"expectDate"`
	OrgUuid         string `json:"orgUuid,optional"`
	OrgName         string `json:"orgName,optional"`
	RequirementDesc string `json:"requirementDesc,optional"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

@server (
	prefix:          /api/v1
	group:           v1/hrm/requirement
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /hrm/getRequirementList (ListRequest) returns (ListResponse)

	@handler Add
	post /hrm/addRequirement (AddRequest) returns (AddResponse)

	@handler Edit
	post /hrm/editRequirement (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deleteRequirement (DeleteRequest) returns (DeleteResponse)
}

