syntax = "v1"

info (
	go_package: "v1/hrm/salary_subject"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

// HrmSalarySubject 薪酬主体（GLOSSARY「薪酬主体」）: 发薪的法人实体，关联一个公司（hrm_org）；
// 薪酬方案与薪资批次都归属主体。
type HrmSalarySubject {
	Uuid        string `json:"uuid"`
	SubjectName string `json:"subjectName"`
	OrgUuid     string `json:"orgUuid"`
	OrgName     string `json:"orgName"`
	PayAccount  string `json:"payAccount"`
	PayBank     string `json:"payBank"`
	Status      string `json:"status"`
	Remark      string `json:"remark"`
	CreateTime  string `json:"createTime"`
	UpdateTime  string `json:"updateTime"`
}

type ListRequest {
	PageRequest
	SubjectName string `form:"subjectName,optional"`
	Status      string `form:"status,optional"`
}

type ListResponse {
	PageResponse
	Records []HrmSalarySubject `json:"records"`
}

type AddRequest {
	SubjectName string `json:"subjectName"`
	OrgUuid     string `json:"orgUuid"`
	PayAccount  string `json:"payAccount,optional"`
	PayBank     string `json:"payBank,optional"`
	Status      string `json:"status,default=1"`
	Remark      string `json:"remark,optional"`
}

type AddResponse {}

type EditRequest {
	Uuid        string `json:"uuid"`
	SubjectName string `json:"subjectName"`
	OrgUuid     string `json:"orgUuid"`
	PayAccount  string `json:"payAccount,optional"`
	PayBank     string `json:"payBank,optional"`
	Status      string `json:"status"`
	Remark      string `json:"remark,optional"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

@server (
	prefix:          /api/v1
	group:           v1/hrm/salary_subject
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /hrm/getSalarySubjectList (ListRequest) returns (ListResponse)

	@handler Add
	post /hrm/addSalarySubject (AddRequest) returns (AddResponse)

	@handler Edit
	post /hrm/editSalarySubject (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deleteSalarySubject (DeleteRequest) returns (DeleteResponse)
}

