syntax = "v1"

info (
	go_package: "v1/hrm/org"
)

import (
	"../../common/response.api"
)

type HrmOrg {
	Uuid       string   `json:"uuid"`
	ParentUuid string   `json:"parentUuid"`
	OrgName    string   `json:"orgName"`
	OrgType    string   `json:"orgType"`
	Leader     string   `json:"leader"`
	OrderNum   int64    `json:"orderNum"`
	Status     string   `json:"status"`
	Remark     string   `json:"remark"`
	CreateTime string   `json:"createTime"`
	UpdateTime string   `json:"updateTime"`
	Children   []HrmOrg `json:"children,optional"`
}

type ListRequest {
	OrgName string `form:"orgName,optional"`
	OrgType string `form:"orgType,optional"`
	Status  string `form:"status,optional"`
}

type ListResponse {
	Records []HrmOrg `json:"records"`
}

type AddRequest {
	ParentUuid string `json:"parentUuid,optional"`
	OrgName    string `json:"orgName"`
	OrgType    string `json:"orgType,default=2"`
	Leader     string `json:"leader,optional"`
	OrderNum   int64  `json:"orderNum,optional"`
	Status     string `json:"status,default=1"`
	Remark     string `json:"remark,optional"`
}

type AddResponse {}

type AddChildRequest {
	ParentUuid string `json:"parentUuid"`
	OrgName    string `json:"orgName"`
	OrgType    string `json:"orgType,default=2"`
	Leader     string `json:"leader,optional"`
	OrderNum   int64  `json:"orderNum,optional"`
	Status     string `json:"status,default=1"`
	Remark     string `json:"remark,optional"`
}

type AddChildResponse {}

type EditRequest {
	Uuid string `json:"uuid"`
	// ParentUuid 可选；非空且不同时表示移动节点（换父组织），空/不变则保持原父
	ParentUuid string `json:"parentUuid,optional"`
	OrgName    string `json:"orgName"`
	OrgType    string `json:"orgType"`
	Leader     string `json:"leader,optional"`
	OrderNum   int64  `json:"orderNum,optional"`
	Status     string `json:"status"`
	Remark     string `json:"remark,optional"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

type ImportRequest {
	FileName string `json:"fileName"`
	Content  string `json:"content"`
}

type ImportResponse {
	SuccessCount int64 `json:"successCount"`
}

type ExportResponse {
	FileName string `json:"fileName"`
	Content  string `json:"content"`
}

// HrmOrgChartNode 组织架构图节点：组织信息 + 负责人 + 本级/汇总人数。
type HrmOrgChartNode {
	Uuid       string `json:"uuid"`
	ParentUuid string `json:"parentUuid"`
	OrgName    string `json:"orgName"`
	OrgType    string `json:"orgType"`
	Leader     string `json:"leader"`
	OrderNum   int64  `json:"orderNum"`
	Status     string `json:"status"`
	// MemberCount 本级人数：直属该组织的在册员工数
	MemberCount int64 `json:"memberCount"`
	// TotalMemberCount 汇总人数：本级人数 + 全部下级组织的汇总人数
	TotalMemberCount int64             `json:"totalMemberCount"`
	Children         []HrmOrgChartNode `json:"children,optional"`
}

type OrgChartResponse {
	Records []HrmOrgChartNode `json:"records"`
}

@server (
	prefix:          /api/v1
	group:           v1/hrm/org
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /hrm/getOrgTree (ListRequest) returns (ListResponse)

	@handler Add
	post /hrm/addOrg (AddRequest) returns (AddResponse)

	@handler AddChild
	post /hrm/addOrgChild (AddChildRequest) returns (AddChildResponse)

	@handler Edit
	post /hrm/editOrg (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deleteOrg (DeleteRequest) returns (DeleteResponse)

	@handler Import
	post /hrm/importOrg (ImportRequest) returns (ImportResponse)

	@handler Export
	get /hrm/exportOrg returns (ExportResponse)

	@handler OrgChart
	get /hrm/getOrgChartTree returns (OrgChartResponse)
}

