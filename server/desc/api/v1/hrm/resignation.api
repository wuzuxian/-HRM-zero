syntax = "v1"

info (
	go_package: "v1/hrm/resignation"
)

import (
	"../../common/request.api"
	"../../common/response.api"
)

// 员工离职单（HR204，GLOSSARY「单据」）：离职类型/离职原因/申请日期/离职日期/
// 最后工作日期/交接人/薪资结算日期，员工档案快照。
// 生命周期（提交/审批/撤销/审批记录）走共享单据底座 v1/hrm/bill，类型码 204。
// 审批通过仅记录（applied=0），定时任务在离职日当天统一将员工 person_status→'5'(离职)。
// 列表默认按「我的单据」过滤（创建人=当前用户），超级管理员可看全部（spec 用户故事 4）。
type HrmResignation {
	Uuid             string `json:"uuid"`
	BillNo           string `json:"billNo"` // 单据编号 HR204-...
	Status           string `json:"status"` // 单据状态 unsubmitted/approving/approved/rejected/revoked
	EmployeeUuid     string `json:"employeeUuid"` // 员工档案 uuid
	EmployeeNo       string `json:"employeeNo"` // 员工工号（快照）
	EmployeeName     string `json:"employeeName"` // 员工姓名（快照）
	OrgUuid          string `json:"orgUuid"` // 员工所属部门（组织 uuid，快照）
	CompanyUuid      string `json:"companyUuid"` // 员工所属公司（组织 uuid，快照）
	Position         string `json:"position"` // 职位（快照）
	Post             string `json:"post"` // 职务（快照）
	ResignType       string `json:"resignType"` // 离职类型 voluntary/involuntary/contract_end/retirement
	ResignReason     string `json:"resignReason"` // 离职原因
	ApplyDate        string `json:"applyDate"` // 申请日期 YYYY-MM-DD
	ResignDate       string `json:"resignDate"` // 离职日期 YYYY-MM-DD（定时任务在当日统一置离职）
	LastWorkDate     string `json:"lastWorkDate"` // 最后工作日期 YYYY-MM-DD
	HandoverPerson   string `json:"handoverPerson"` // 交接人
	SalarySettleDate string `json:"salarySettleDate"` // 薪资结算日期 YYYY-MM-DD
	Applied          int64  `json:"applied"` // 离职生效是否已完成 1=是 0=否
	CreatorUuid      string `json:"creatorUuid"` // 申请人 uuid
	CreatorName      string `json:"creatorName"` // 申请人姓名
	CreateTime       string `json:"createTime"`
	UpdateTime       string `json:"updateTime"`
}

type ListRequest {
	PageRequest
	BillNo     string `form:"billNo,optional"` // 单据编号（模糊）
	Status     string `form:"status,optional"` // 单据状态
	EmployeeNo string `form:"employeeNo,optional"` // 员工工号（模糊）
	Mine       int64  `form:"mine,optional"` // 1=强制只看我的单据（默认行为即我的单据，管理员可看全部由后端角色判定兜底）
}

type ListResponse {
	PageResponse
	Records []HrmResignation `json:"records"`
}

type AddRequest {
	EmployeeUuid     string `json:"employeeUuid,optional"`
	EmployeeNo       string `json:"employeeNo"`
	EmployeeName     string `json:"employeeName"`
	OrgUuid          string `json:"orgUuid,optional"`
	CompanyUuid      string `json:"companyUuid,optional"`
	Position         string `json:"position,optional"`
	Post             string `json:"post,optional"`
	ResignType       string `json:"resignType"`
	ResignReason     string `json:"resignReason,optional"`
	ApplyDate        string `json:"applyDate,optional"` // YYYY-MM-DD，默认取创建当日
	ResignDate       string `json:"resignDate"` // YYYY-MM-DD，离职日定时任务生效日
	LastWorkDate     string `json:"lastWorkDate,optional"`
	HandoverPerson   string `json:"handoverPerson,optional"`
	SalarySettleDate string `json:"salarySettleDate,optional"`
}

type AddResponse {}

type EditRequest {
	Uuid             string `json:"uuid"`
	EmployeeUuid     string `json:"employeeUuid,optional"`
	EmployeeNo       string `json:"employeeNo"`
	EmployeeName     string `json:"employeeName"`
	OrgUuid          string `json:"orgUuid,optional"`
	CompanyUuid      string `json:"companyUuid,optional"`
	Position         string `json:"position,optional"`
	Post             string `json:"post,optional"`
	ResignType       string `json:"resignType"`
	ResignReason     string `json:"resignReason,optional"`
	ApplyDate        string `json:"applyDate,optional"`
	ResignDate       string `json:"resignDate"`
	LastWorkDate     string `json:"lastWorkDate,optional"`
	HandoverPerson   string `json:"handoverPerson,optional"`
	SalarySettleDate string `json:"salarySettleDate,optional"`
}

type EditResponse {}

type DeleteRequest {
	Uuids []string `json:"uuids"`
}

type DeleteResponse {}

@server (
	prefix:          /api/v1
	group:           v1/hrm/resignation
	compact_handler: true
	jwt:             Jwt
	middleware:      Authx
)
service server {
	@handler List
	get /hrm/getResignationList (ListRequest) returns (ListResponse)

	@handler Add
	post /hrm/addResignation (AddRequest) returns (AddResponse)

	@handler Edit
	post /hrm/editResignation (EditRequest) returns (EditResponse)

	@handler Delete
	post /hrm/deleteResignation (DeleteRequest) returns (DeleteResponse)
}

