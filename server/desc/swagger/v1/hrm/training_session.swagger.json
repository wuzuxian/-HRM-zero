    "/api/v1/hrm/getSessionParticipantList": {
      "get": {
        "description": "接口权限编码:v1:hrm:training_session:getSessionParticipantList",
        "operationId": "v1/Hrm/TrainingSessionGetSessionParticipantList",
        "parameters": [
          {
