    "/api/v1/hrm/getTrainingSessionList": {
      "get": {
        "description": "接口权限编码:v1:hrm:training_session:list",
        "operationId": "v1/Hrm/TrainingSessionList",
        "parameters": [
          {
            "allowEmptyValue": true,
            "default": 1,
            "in": "query",
            "name": "current",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "default": 10,
            "in": "query",
            "name": "size",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "description": "班次名称（模糊）",
            "in": "query",
            "name": "sessionName",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "培训计划",
            "in": "query",
            "name": "planUuid",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "班次状态",
            "in": "query",
            "name": "status",
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "properties": {
                "current": {
                  "type": "integer"
                },
                "records": {
                  "items": {
                    "properties": {
                      "createTime": {
                        "type": "string"
                      },
                      "endTime": {
                        "description": "结束时间",
                        "type": "string"
                      },
                      "hours": {
                        "description": "学时",
                        "type": "number"
                      },
                      "lecturer": {
                        "description": "讲师",
                        "type": "string"
                      },
                      "location": {
                        "description": "地点",
                        "type": "string"
                      },
                      "planName": {
                        "description": "关联培训计划名称（展示快照）",
                        "type": "string"
                      },
                      "planUuid": {
                        "description": "关联培训计划 uuid",
                        "type": "string"
                      },
                      "remark": {
                        "type": "string"
                      },
                      "sessionName": {
                        "type": "string"
                      },
                      "sessionNo": {
                        "description": "班次编号 PX-年-流水",
                        "type": "string"
                      },
                      "startTime": {
                        "description": "开始时间",
                        "type": "string"
                      },
                      "status": {
                        "description": "1=未开始 2=进行中 3=已结束",
                        "type": "string"
                      },
                      "updateTime": {
                        "type": "string"
                      },
                      "uuid": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "uuid",
                      "sessionNo",
                      "sessionName",
                      "planUuid",
                      "planName",
                      "lecturer",
                      "location",
                      "hours",
                      "startTime",
                      "endTime",
                      "status",
                      "remark",
                      "createTime",
                      "updateTime"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "size": {
                  "type": "integer"
                },
                "total": {
                  "type": "integer"
                }
              },
              "type": "object"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "List",
        "tags": [
          "v1/hrm/training_session"
        ]
      }
    },
