    "/api/v1/hrm/getSigninDetailList": {
      "get": {
        "description": "接口权限编码:v1:hrm:signin:getSigninDetailList",
        "operationId": "v1/Hrm/SigninGetSigninDetailList",
        "parameters": [
          {
            "in": "query",
            "name": "sessionUuid",
            "required": true,
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "properties": {
                "records": {
                  "items": {
                    "properties": {
                      "employeeNo": {
                        "description": "工号（关联员工档案，可为空）",
                        "type": "string"
                      },
                      "nickName": {
                        "description": "姓名",
                        "type": "string"
                      },
                      "orgName": {
                        "description": "部门（关联员工档案 org，可为空）",
                        "type": "string"
                      },
                      "sessionUuid": {
                        "type": "string"
                      },
                      "signInBy": {
                        "description": "操作人（自签=本人，补签=管理员）",
                        "type": "string"
                      },
                      "signInByName": {
                        "description": "操作人姓名（展示）",
                        "type": "string"
                      },
                      "signInMethod": {
                        "description": "1=扫码自签 2=管理员补签（空=未签）",
                        "type": "string"
                      },
                      "signInReason": {
                        "description": "补签原因",
                        "type": "string"
                      },
                      "signInTime": {
                        "description": "签到时间（空=未签）",
                        "type": "string"
                      },
                      "userUuid": {
                        "type": "string"
                      },
                      "username": {
                        "description": "学员账号",
                        "type": "string"
                      },
                      "uuid": {
                        "description": "participant row uuid",
                        "type": "string"
                      }
                    },
                    "required": [
                      "uuid",
                      "sessionUuid",
                      "userUuid",
                      "username",
                      "nickName",
                      "employeeNo",
                      "orgName",
                      "signInTime",
                      "signInMethod",
                      "signInBy",
                      "signInByName",
                      "signInReason"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "GetSigninDetailList",
        "tags": [
          "v1/hrm/signin"
        ]
      }
    },
