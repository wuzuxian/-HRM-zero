  "paths": {
    "/api/v1/hrm/addReward": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "接口权限编码:v1:hrm:reward:add",
        "operationId": "v1/Hrm/RewardAdd",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "amount": {
                  "type": "number"
                },
                "docNo": {
                  "type": "string"
                },
                "employeeName": {
                  "type": "string"
                },
                "employeeNo": {
                  "type": "string"
                },
                "employeeUuid": {
                  "type": "string"
                },
                "occurDate": {
                  "description": "YYYY-MM-DD",
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "rewardLevel": {
                  "type": "string"
                },
                "rewardType": {
                  "type": "string"
                },
                "salaryMonth": {
                  "description": "YYYY-MM，空=发生日期所在月",
                  "type": "string"
                }
              },
              "required": [
                "employeeNo",
                "employeeName",
                "rewardType",
                "rewardLevel",
                "occurDate"
              ],
              "type": "object"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "type": "object"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Add",
        "tags": [
          "v1/hrm/reward"
        ]
      }
    },
    "/api/v1/hrm/deleteReward": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "接口权限编码:v1:hrm:reward:delete",
        "operationId": "v1/Hrm/RewardDelete",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "uuids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "uuids"
              ],
              "type": "object"
            }
          }
        ],
