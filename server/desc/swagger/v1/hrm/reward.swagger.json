            "apiKey": []
          }
        ],
        "summary": "Delete",
        "tags": [
          "v1/hrm/reward"
        ]
      }
    },
    "/api/v1/hrm/editReward": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "接口权限编码:v1:hrm:reward:edit",
        "operationId": "v1/Hrm/RewardEdit",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "amount": {
                  "type": "number"
                },
                "docNo": {
                  "type": "string"
                },
                "employeeName": {
                  "type": "string"
                },
                "employeeNo": {
                  "type": "string"
                },
                "employeeUuid": {
                  "type": "string"
                },
                "occurDate": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "rewardLevel": {
                  "type": "string"
                },
                "rewardType": {
                  "type": "string"
                },
                "salaryMonth": {
                  "type": "string"
                },
                "uuid": {
                  "type": "string"
                }
              },
              "required": [
                "uuid",
                "employeeNo",
                "employeeName",
                "rewardType",
                "rewardLevel",
                "occurDate"
              ],
              "type": "object"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "type": "object"
            }
          }
        },
        "schemes": [
