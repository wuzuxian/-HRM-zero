              "properties": {
                "current": {
                  "type": "integer"
                },
                "records": {
                  "items": {
                    "properties": {
                      "accrueHours": {
                        "description": "折算调休入账小时（审批通过落定）",
                        "type": "number"
                      },
                      "applyHours": {
                        "description": "申请时长（小时，自动计算）",
                        "type": "number"
                      },
                      "billNo": {
                        "description": "单据编号 HR217-...",
                        "type": "string"
                      },
                      "compMultiplier": {
                        "description": "调休倍数（提交时快照）",
                        "type": "number"
                      },
                      "compType": {
                        "description": "补偿方式 comp_leave=调休 other=其他",
                        "type": "string"
                      },
                      "confirmHours": {
                        "description": "核定时长（小时，0=未核定）",
                        "type": "number"
                      },
                      "createTime": {
                        "type": "string"
                      },
                      "creatorName": {
                        "description": "申请人姓名",
                        "type": "string"
                      },
                      "creatorUuid": {
                        "description": "申请人 uuid",
                        "type": "string"
                      },
                      "dayType": {
                        "description": "当天类型 1=工作日 2=休息日 3=法定节假日",
                        "type": "string"
                      },
                      "employeeName": {
                        "description": "员工姓名（快照）",
                        "type": "string"
                      },
                      "employeeNo": {
                        "description": "员工工号（快照）",
                        "type": "string"
                      },
                      "employeeUuid": {
                        "description": "员工档案 uuid",
                        "type": "string"
                      },
                      "endTime": {
                        "description": "结束时间 YYYY-MM-DD HH:MM:SS",
                        "type": "string"
                      },
                      "orgName": {
                        "description": "部门名称（快照）",
                        "type": "string"
                      },
                      "orgUuid": {
                        "description": "员工所属部门（组织 uuid，快照）",
                        "type": "string"
                      },
                      "overtimeDate": {
                        "description": "加班日期 YYYY-MM-DD",
                        "type": "string"
                      },
                      "reason": {
                        "description": "加班事由",
                        "type": "string"
                      },
                      "ruleSource": {
                        "description": "命中加班规则来源 group/org/global",
                        "type": "string"
                      },
                      "settled": {
                        "description": "调休入账是否已完成 1=是 0=否",
                        "type": "integer"
                      },
                      "source": {
                        "description": "来源 employee=员工申请",
                        "type": "string"
                      },
                      "startTime": {
                        "description": "开始时间 YYYY-MM-DD HH:MM:SS",
                        "type": "string"
                      },
                      "status": {
                        "description": "单据状态 unsubmitted/approving/approved/rejected/revoked",
                        "type": "string"
                      },
                      "updateTime": {
                        "type": "string"
                      },
                      "uuid": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "uuid",
                      "billNo",
                      "status",
                      "employeeUuid",
                      "employeeNo",
                      "employeeName",
                      "orgUuid",
                      "orgName",
                      "overtimeDate",
                      "dayType",
                      "startTime",
                      "endTime",
                      "applyHours",
                      "reason",
                      "source",
                      "ruleSource",
                      "compMultiplier",
                      "confirmHours",
                      "compType",
                      "accrueHours",
                      "settled",
                      "creatorUuid",
                      "creatorName",
                      "createTime",
                      "updateTime"
