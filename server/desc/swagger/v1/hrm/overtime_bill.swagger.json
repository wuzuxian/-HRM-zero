            "name": "dayType",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "1=强制只看我的单据",
            "in": "query",
            "name": "mine",
            "type": "integer"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
