    "/api/v1/hrm/getOvertimeBillList": {
      "get": {
        "description": "接口权限编码:v1:hrm:overtimebill:list",
        "operationId": "v1/Hrm/OvertimebillList",
        "parameters": [
          {
            "allowEmptyValue": true,
            "default": 1,
            "in": "query",
            "name": "current",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "default": 10,
