                        "description": "员工档案 uuid",
                        "type": "string"
                      },
                      "handoverPerson": {
                        "description": "交接人",
                        "type": "string"
                      },
                      "lastWorkDate": {
                        "description": "最后工作日期 YYYY-MM-DD",
                        "type": "string"
                      },
                      "orgUuid": {
                        "description": "员工所属部门（组织 uuid，快照）",
                        "type": "string"
                      },
                      "position": {
                        "description": "职位（快照）",
                        "type": "string"
                      },
                      "post": {
                        "description": "职务（快照）",
                        "type": "string"
                      },
