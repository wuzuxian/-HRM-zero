                        "description": "员工所属公司（组织 uuid，快照）",
                        "type": "string"
                      },
                      "createTime": {
                        "type": "string"
                      },
                      "creatorName": {
                        "description": "申请人姓名",
                        "type": "string"
                      },
                      "creatorUuid": {
                        "description": "申请人 uuid",
                        "type": "string"
                      },
                      "employeeName": {
                        "description": "员工姓名（快照）",
                        "type": "string"
