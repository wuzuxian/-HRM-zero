                      },
                      "salarySettleDate": {
                        "description": "薪资结算日期 YYYY-MM-DD",
                        "type": "string"
                      },
                      "status": {
                        "description": "单据状态 unsubmitted/approving/approved/rejected/revoked",
                        "type": "string"
                      },
                      "updateTime": {
                        "type": "string"
                      },
                      "uuid": {
                        "type": "string"
                      }
