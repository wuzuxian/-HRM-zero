                    "required": [
                      "uuid",
                      "billNo",
                      "status",
                      "employeeUuid",
                      "employeeNo",
                      "employeeName",
                      "orgUuid",
                      "companyUuid",
                      "position",
                      "post",
                      "resignType",
                      "resignReason",
                      "applyDate",
                      "resignDate",
                      "lastWorkDate",
                      "handoverPerson",
                      "salarySettleDate",
