{
  "basePath": "/",
  "consumes": [
    "application/json"
  ],
  "info": {
    "version": "1.0"
  },
  "paths": {
    "/api/v1/hrm/addOffer": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "接口权限编码:v1:hrm:offer:add",
        "operationId": "v1/Hrm/OfferAdd",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "candidateUuid": {
                  "description": "候选人（仅 status=offer）",
                  "type": "string"
                },
                "planEntryDate": {
                  "description": "计划入职日期 YYYY-MM-DD",
                  "type": "string"
                },
                "positionUuid": {
                  "description": "招聘职位（仅 status=open）",
                  "type": "string"
                },
                "probationMonths": {
                  "description": "试用期(月)",
                  "type": "integer"
                },
                "rankLevel": {
                  "description": "职级，默认 junior",
                  "type": "string"
                },
                "reporterName": {
                  "description": "汇报人",
                  "type": "string"
                }
              },
              "required": [
                "candidateUuid",
                "positionUuid",
                "planEntryDate",
                "probationMonths"
              ],
              "type": "object"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "type": "object"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Add",
        "tags": [
          "v1/hrm/offer"
        ]
      }
    },
    "/api/v1/hrm/deleteOffer": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "接口权限编码:v1:hrm:offer:delete",
        "operationId": "v1/Hrm/OfferDelete",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "uuids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "uuids"
              ],
              "type": "object"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "type": "object"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Delete",
        "tags": [
          "v1/hrm/offer"
        ]
      }
    },
    "/api/v1/hrm/editOffer": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "接口权限编码:v1:hrm:offer:edit",
        "operationId": "v1/Hrm/OfferEdit",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "candidateUuid": {
                  "type": "string"
                },
                "planEntryDate": {
                  "type": "string"
                },
                "positionUuid": {
                  "type": "string"
                },
                "probationMonths": {
                  "type": "integer"
                },
                "rankLevel": {
                  "type": "string"
                },
                "reporterName": {
                  "type": "string"
                },
                "uuid": {
                  "type": "string"
                }
              },
              "required": [
                "uuid",
                "candidateUuid",
                "positionUuid",
                "planEntryDate",
                "probationMonths"
              ],
              "type": "object"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "type": "object"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Edit",
        "tags": [
          "v1/hrm/offer"
        ]
      }
    },
    "/api/v1/hrm/getOfferList": {
      "get": {
        "description": "接口权限编码:v1:hrm:offer:list",
        "operationId": "v1/Hrm/OfferList",
        "parameters": [
          {
            "allowEmptyValue": true,
            "default": 1,
            "in": "query",
            "name": "current",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "default": 10,
            "in": "query",
            "name": "size",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "description": "单据编号（模糊）",
            "in": "query",
            "name": "billNo",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "单据状态",
            "in": "query",
            "name": "status",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "候选人（筛选）",
            "in": "query",
            "name": "candidateUuid",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "1=强制只看我的单据",
            "in": "query",
            "name": "mine",
            "type": "integer"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "properties": {
                "current": {
                  "type": "integer"
                },
                "records": {
                  "items": {
                    "properties": {
                      "billNo": {
                        "description": "单据编号 HR208-...",
                        "type": "string"
                      },
                      "candidateName": {
                        "description": "候选人姓名（快照）",
                        "type": "string"
                      },
                      "candidateUuid": {
                        "description": "候选人 uuid",
                        "type": "string"
                      },
                      "createTime": {
                        "type": "string"
                      },
                      "creatorName": {
                        "description": "申请人姓名",
                        "type": "string"
                      },
                      "creatorUuid": {
                        "description": "申请人 uuid",
                        "type": "string"
                      },
                      "entryBillUuid": {
                        "description": "审批通过后创建的入职单 uuid",
                        "type": "string"
                      },
                      "orgName": {
                        "description": "部门名称（快照）",
                        "type": "string"
                      },
                      "orgUuid": {
                        "description": "所属部门（组织 uuid，快照）",
                        "type": "string"
                      },
                      "planEntryDate": {
                        "description": "计划入职日期 YYYY-MM-DD",
                        "type": "string"
                      },
                      "positionUuid": {
                        "description": "招聘职位 uuid",
                        "type": "string"
                      },
                      "postName": {
                        "description": "岗位名称（快照）",
                        "type": "string"
                      },
                      "probationMonths": {
                        "description": "试用期(月)",
                        "type": "integer"
                      },
                      "rankLevel": {
                        "description": "职级 junior/intermediate/senior/expert",
                        "type": "string"
                      },
                      "reporterName": {
                        "description": "汇报人",
                        "type": "string"
                      },
                      "status": {
                        "description": "单据状态 unsubmitted/approving/approved/rejected/revoked",
                        "type": "string"
                      },
                      "updateTime": {
                        "type": "string"
                      },
                      "uuid": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "uuid",
                      "billNo",
                      "status",
                      "candidateUuid",
                      "candidateName",
                      "positionUuid",
                      "postName",
                      "orgUuid",
                      "orgName",
                      "planEntryDate",
                      "probationMonths",
                      "rankLevel",
                      "reporterName",
                      "entryBillUuid",
                      "creatorUuid",
                      "creatorName",
                      "createTime",
                      "updateTime"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "size": {
                  "type": "integer"
                },
                "total": {
                  "type": "integer"
                }
              },
              "type": "object"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "List",
        "tags": [
          "v1/hrm/offer"
        ]
      }
    }
  },
  "produces": [
    "application/json"
  ],
  "schemes": [
    "http",
    "https"
  ],
  "securityDefinitions": {
    "apiKey": {
      "description": "Enter Authorization",
      "in": "header",
      "name": "Authorization",
      "type": "apiKey"
    }
  },
  "swagger": "2.0"
}