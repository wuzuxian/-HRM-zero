                        "type": "string"
                      },
                      "createTime": {
                        "type": "string"
                      },
                      "creatorName": {
                        "description": "申请人姓名",
                        "type": "string"
                      },
                      "creatorUuid": {
                        "description": "申请人 uuid",
                        "type": "string"
                      },
                      "employeeName": {
                        "description": "员工姓名（快照）",
                        "type": "string"
                      },
                      "employeeNo": {
                        "description": "员工工号（快照）",
                        "type": "string"
                      },
