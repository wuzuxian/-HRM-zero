                        "description": "员工档案 uuid",
                        "type": "string"
                      },
                      "expectedFormalDate": {
                        "description": "预计转正日期 YYYY-MM-DD（快照）",
                        "type": "string"
                      },
                      "formalDate": {
                        "description": "实际转正日期 YYYY-MM-DD",
                        "type": "string"
                      },
                      "hireDate": {
                        "description": "入职日期 YYYY-MM-DD（快照）",
                        "type": "string"
                      },
                      "orgUuid": {
                        "description": "员工所属部门（组织 uuid，快照）",
                        "type": "string"
                      },
                      "personStatus": {
                        "description": "人员状态（快照，制单时档案值）",
                        "type": "string"
                      },
                      "position": {
                        "description": "职位（快照）",
                        "type": "string"
                      },
                      "post": {
                        "description": "职务（快照）",
                        "type": "string"
