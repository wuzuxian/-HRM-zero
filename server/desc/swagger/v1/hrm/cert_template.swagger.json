                      },
                      "createTime": {
                        "type": "string"
                      },
                      "noPrefix": {
                        "description": "编号前缀（HF/CE/YX/XF/RZ/JN/SG/AQ/HG/JX…）",
                        "type": "string"
                      },
                      "remark": {
                        "type": "string"
                      },
                      "source": {
                        "description": "来源 1=系统 2=企业",
                        "type": "string"
                      },
                      "status": {
                        "description": "1=启用 2=停用",
                        "type": "string"
                      },
                      "templateName": {
                        "description": "模板名称",
                        "type": "string"
                      },
                      "updateTime": {
                        "type": "string"
                      },
                      "uuid": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "uuid",
                      "templateName",
                      "certType",
                      "source",
                      "noPrefix",
                      "status",
                      "remark",
                      "createTime",
                      "updateTime"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "size": {
                  "type": "integer"
                },
                "total": {
                  "type": "integer"
                }
              },
              "type": "object"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "List",
        "tags": [
          "v1/hrm/cert_template"
