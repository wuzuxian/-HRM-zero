            "description": "状态",
            "in": "query",
            "name": "status",
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "properties": {
                "current": {
                  "type": "integer"
                },
                "records": {
                  "items": {
                    "properties": {
                      "certType": {
                        "description": "证书类型（合格证/继续教育/荣誉/安全培训证/结业证/技能证明/上岗证/企业…）",
