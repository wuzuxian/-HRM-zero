    "/api/v1/hrm/getCertTemplateList": {
      "get": {
        "description": "接口权限编码:v1:hrm:cert_template:list",
        "operationId": "v1/Hrm/CertTemplateList",
        "parameters": [
          {
            "allowEmptyValue": true,
            "default": 1,
            "in": "query",
            "name": "current",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "default": 10,
            "in": "query",
            "name": "size",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "description": "模板名称（模糊）",
