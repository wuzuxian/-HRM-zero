            "name": "templateName",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "证书类型",
            "in": "query",
            "name": "certType",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "来源",
            "in": "query",
            "name": "source",
            "type": "string"
          },
          {
