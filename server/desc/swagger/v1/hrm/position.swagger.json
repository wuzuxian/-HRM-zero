        ],
        "description": "接口权限编码:v1:hrm:position:add",
        "operationId": "v1/Hrm/PositionAdd",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "headcount": {
                  "type": "integer"
                },
                "ownerName": {
                  "type": "string"
                },
                "ownerUuid": {
                  "type": "string"
                },
                "postCategory": {
                  "type": "string"
                },
                "postName": {
                  "type": "string"
                },
                "publishDate": {
                  "type": "string"
                },
                "remark": {
                  "type": "string"
                },
                "requirementUuid": {
                  "description": "必填，仅 approved 需求单可引用",
                  "type": "string"
                }
              },
              "required": [
                "postName",
                "requirementUuid",
                "postCategory",
                "headcount"
