    "/api/v1/hrm/getPositionList": {
      "get": {
        "description": "接口权限编码:v1:hrm:position:list",
        "operationId": "v1/Hrm/PositionList",
        "parameters": [
          {
            "allowEmptyValue": true,
            "default": 1,
            "in": "query",
            "name": "current",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "default": 10,
            "in": "query",
            "name": "size",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "description": "岗位名称（模糊）",
            "in": "query",
            "name": "postName",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "来源需求单",
            "in": "query",
            "name": "requirementUuid",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "岗位类别",
            "in": "query",
            "name": "postCategory",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "职位状态",
            "in": "query",
            "name": "status",
            "type": "string"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "properties": {
                "current": {
                  "type": "integer"
                },
                "records": {
                  "items": {
                    "properties": {
                      "createTime": {
                        "type": "string"
                      },
                      "headcount": {
                        "description": "招聘人数",
                        "type": "integer"
                      },
                      "hiredCount": {
                        "description": "已录用人数",
                        "type": "integer"
                      },
                      "ownerName": {
                        "description": "招聘负责人姓名",
                        "type": "string"
                      },
                      "ownerUuid": {
                        "description": "招聘负责人 uuid",
                        "type": "string"
                      },
                      "postCategory": {
                        "description": "岗位类别 tech/product/design/operation/market/function/other",
                        "type": "string"
                      },
                      "postName": {
                        "description": "岗位名称",
                        "type": "string"
                      },
                      "publishDate": {
                        "description": "发布日期 YYYY-MM-DD",
                        "type": "string"
                      },
                      "remark": {
                        "description": "备注",
                        "type": "string"
                      },
                      "requirementBillNo": {
                        "description": "来源需求单单据编号快照（列表展示）",
                        "type": "string"
                      },
                      "requirementUuid": {
                        "description": "来源需求单 uuid（approved）",
                        "type": "string"
                      },
                      "status": {
                        "description": "职位状态 open=招聘中 full=已满 closed=已关闭",
                        "type": "string"
                      },
                      "updateTime": {
                        "type": "string"
                      },
                      "uuid": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "uuid",
                      "postName",
                      "requirementUuid",
                      "requirementBillNo",
                      "postCategory",
                      "ownerUuid",
                      "ownerName",
                      "headcount",
                      "hiredCount",
                      "publishDate",
                      "status",
                      "remark",
                      "createTime",
                      "updateTime"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "size": {
                  "type": "integer"
                },
                "total": {
                  "type": "integer"
                }
              },
              "type": "object"
            }
          }
        },
        "schemes": [
          "https"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "List",
        "tags": [
          "v1/hrm/position"
        ]
      }
    },
