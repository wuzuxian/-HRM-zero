    "/api/v1/hrm/editPosition": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "接口权限编码:v1:hrm:position:edit",
        "operationId": "v1/Hrm/PositionEdit",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "headcount": {
                  "type": "integer"
                },
                "ownerName": {
                  "type": "string"
                },
