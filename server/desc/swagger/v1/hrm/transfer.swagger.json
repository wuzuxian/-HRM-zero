                        "description": "单据编号 HR203-...",
                        "type": "string"
                      },
                      "changeType": {
                        "description": "异动类型 post/org/salary/company/other",
                        "type": "string"
                      },
                      "createTime": {
                        "type": "string"
                      },
                      "creatorName": {
                        "description": "申请人姓名",
                        "type": "string"
                      },
                      "creatorUuid": {
                        "description": "申请人 uuid",
                        "type": "string"
                      },
                      "effectiveDate": {
                        "description": "生效日期 YYYY-MM-DD",
                        "type": "string"
                      },
                      "effectiveImmediately": {
                        "description": "是否立即生效 1=是 0=否",
                        "type": "integer"
                      },
