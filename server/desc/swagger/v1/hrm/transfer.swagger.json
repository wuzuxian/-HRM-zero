                        "description": "员工姓名",
                        "type": "string"
                      },
                      "employeeNo": {
                        "description": "员工工号",
                        "type": "string"
                      },
                      "employeeUuid": {
                        "description": "员工档案 uuid",
                        "type": "string"
                      },
                      "newCompany": {
                        "description": "新公司（组织 uuid）",
                        "type": "string"
                      },
                      "newOrg": {
                        "description": "新部门（组织 uuid）",
                        "type": "string"
                      },
                      "newPosition": {
                        "description": "新职位",
                        "type": "string"
                      },
                      "newPost": {
                        "description": "新岗位",
                        "type": "string"
                      },
                      "newSalary": {
                        "description": "调整后薪资（调薪时填写）",
                        "type": "number"
                      },
                      "originalCompany": {
                        "description": "原公司（组织 uuid）",
                        "type": "string"
                      },
                      "originalOrg": {
                        "description": "原部门（组织 uuid）",
                        "type": "string"
                      },
                      "originalPosition": {
                        "description": "原职位",
                        "type": "string"
                      },
                      "originalPost": {
                        "description": "原岗位",
                        "type": "string"
                      },
                      "status": {
                        "description": "单据状态 unsubmitted/approving/approved/rejected/revoked",
                        "type": "string"
                      },
                      "transferReason": {
                        "description": "调动原因",
                        "type": "string"
                      },
                      "updateTime": {
                        "type": "string"
                      },
                      "uuid": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "uuid",
                      "billNo",
                      "status",
                      "employeeUuid",
                      "employeeNo",
                      "employeeName",
                      "changeType",
                      "originalCompany",
                      "originalOrg",
                      "originalPosition",
                      "originalPost",
                      "newCompany",
                      "newOrg",
                      "newPosition",
                      "newPost",
                      "newSalary",
                      "transferReason",
                      "effectiveImmediately",
                      "effectiveDate",
                      "applied",
                      "creatorUuid",
