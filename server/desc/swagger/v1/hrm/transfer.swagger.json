    "/api/v1/hrm/getTransferList": {
      "get": {
        "description": "接口权限编码:v1:hrm:transfer:list",
        "operationId": "v1/Hrm/TransferList",
        "parameters": [
          {
            "allowEmptyValue": true,
            "default": 1,
            "in": "query",
            "name": "current",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "default": 10,
            "in": "query",
            "name": "size",
            "type": "integer"
          },
          {
            "allowEmptyValue": true,
            "description": "单据编号（模糊）",
            "in": "query",
            "name": "billNo",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "单据状态",
            "in": "query",
            "name": "status",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "员工工号（模糊）",
            "in": "query",
            "name": "employeeNo",
            "type": "string"
          },
          {
            "allowEmptyValue": true,
            "description": "1=强制只看我的单据（默认行为即我的单据，管理员可传 0 看全部由后端角色判定兜底）",
