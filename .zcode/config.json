{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "process",
              "command": "python3",
              "enabled": true,
              "statusMessage": "generated-file guard",
              "args": [
                "/home/wuzuxian/-HRM-zero/.zcode/hooks/no-edit-generated.py"
              ],
              "timeoutMs": 5000
            },
            {
              "type": "process",
              "command": "python3",
              "enabled": true,
              "statusMessage": "logic structure guard",
              "args": [
                "/home/wuzuxian/-HRM-zero/.zcode/hooks/no-break-logic.py"
              ],
              "timeoutMs": 5000
            }
          ]
        }
      ]
    }
  }
}
